# Firebase Admin UID الخاص بالمالك — يُستخدم للتحقق من صلاحيات الأدمن
OWNER_OPEN_ID=

# رابط الموقع الأساسي (يُستخدم لبناء الروابط داخل الإيميلات وغيرها)
SITE_BASE_URL=

# عدد البروكسيات الموثوقة أمام السيرفر (مثلاً 1 على Render/Railway؛ 2 إن وُضع Cloudflare قبله).
# يمنع تزوير هيدر X-Forwarded-For لتجاوز محدّدات الطلبات. بدونه يبقى السلوك القديم.
RATE_LIMIT_PROXY_HOPS=1

# نطاق إنتاج إضافي مسموح له بإرسال طلبات كتابة (يُضاف لقائمة CORS وحماية CSRF). اختياري.
EXTRA_CORS_ORIGIN=
