# انسخ هذا الملف إلى functions/.env قبل النشر (firebase deploy --only functions)
# نفس قيمة OWNER_OPEN_ID المضبوطة بمتغيرات بيئة السيرفر الرئيسي (server/.env) بالضبط —
# هي معرّف حساب صاحب المتجر الذي يستلم إشعار "طلب جديد" عند وصول أي طلب.
OWNER_OPEN_ID=

# نفس رابط الموقع المستخدم لبناء رابط فتح الإشعار على المتصفح (webpush.fcmOptions.link)
SITE_BASE_URL=https://eleven-sd.com
