# ELEVEN STORE — متغيرات بيئة لوحة التحكم/الموقع (client)
# ─────────────────────────────────────────────────────────────────────────
# ✅ إضافة: لم يكن يوجد ملف .env.example هنا إطلاقاً قبل هذه المراجعة، رغم
# أن firebase.ts يفشل الإقلاع فوراً (fail-fast) بدون REQUIRED_ENV_KEYS
# الستة الأولى أدناه. نسخ هذا الملف إلى .env وتعبئة القيم الحقيقية قبل أي
# تشغيل محلي أو نشر جديد.
#
# كل متغير هنا يبدأ بـVITE_ لأنه يُقرأ وقت البناء (import.meta.env) بواسطة
# Vite — أي تعديل على قيمته لا يكفي معه إعادة تشغيل الحاوية على Render،
# بل يتطلب Redeploy/Rebuild كامل.

# --- مطلوبة (Firebase Web SDK) — بلا أي قيمة، الإقلاع يفشل صراحةً ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- App Check (reCAPTCHA v3) ---
# ⚠️ حرجة إن كان "Enforce" مفعّلاً بـFirebase Console → App Check:
# بدونها، Firestore يرفض كل الاتصالات المباشرة من هذا الموقع (الإشعارات
# المباشرة تحديداً — راجع lib/firebase.ts وlib/firestoreConnectionStatus.ts).
# احصل عليها من: Firebase Console → App Check → تطبيق الويب → reCAPTCHA v3.
VITE_RECAPTCHA_SITE_KEY=

# --- اختيارية ---
# مفتاح VAPID لإشعارات Web Push (FCM) — راجع lib/push.ts. بدونه، طلب صلاحية
# الإشعارات بالمتصفح يفشل بصمت (لا يوقف باقي التطبيق).
# VITE_FCM_VAPID_KEY=
