rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  ELEVEN STORE — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════
//  ملاحظة مهمة جداً قبل القراءة:
//  • السيرفر (store/server عبر tRPC) يستخدم Firebase Admin SDK — وهذا يتجاوز
//    هذه القواعد بالكامل دائماً. القواعد هنا لا "تحمي" الويب في أغلب مساراته
//    لأنه لا يتحدث مع Firestore مباشرة إلا في حالة واحدة (Register.tsx).
//  • تطبيق الأندرويد يتحدث مع Firestore مباشرة عبر Client SDK في كل شيء —
//    فهذه القواعد هي خط الدفاع الحقيقي الوحيد لكل عمليات الأندرويد.
//  • بدون نشر هذا الملف فعلياً (firebase deploy --only firestore:rules)
//    فإن أي شخص يملك مفاتيح Firebase العامة (موجودة أصلاً بكود التطبيق/الموقع،
//    وهذا طبيعي وليس تسريباً) يقدر يقرأ/يكتب أي شيء في القاعدة مباشرة.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    //  دوال مساعدة عامة
    // ─────────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ⚠️ يقرأ مستند المستخدم نفسه للتحقق من الدور — استخدام get() هنا مقصود
    // ومحدود (مرة واحدة فقط لكل تحقق)، ولا يوجد تطبيق أندرويد إداري حالياً
    // (لوحة التحكم كلها بالموقع عبر Admin SDK)، لكن هذا يبقى خط دفاع إضافي.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // فرق الحقول المتغيّرة بين النسخة القديمة والجديدة — لتقييد أي تحديث
    // على حقول محدّدة فقط (مثال: لا يمكن تغيير أي شيء عدا "stock")
    function onlyChangedKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ─────────────────────────────────────────────────────────────────────
    //  ✅ إصلاح (Audit C-1): تحقق من سعر كل عنصر مقابل مستند المنتج الحيّ.
    //  Firestore Rules لا تدعم loops، لذا نتحقق بفهرس صريح حتى حد أقصى ثابت
    //  لعدد العناصر (10) — orders/create يفرض items.size() <= 10 أدناه.
    //  أي عنصر خارج هذا النطاق (index >= items.size()) يُعتبر صحيحاً تلقائياً
    //  (لا وجود له أصلاً)، بحيث تدعم الدالة أي عدد عناصر من 1 إلى 10.
    // ─────────────────────────────────────────────────────────────────────
    function validItemAt(items, i) {
      return items.size() <= i ||
        (
          items[i].quantity is number && items[i].quantity > 0 &&
          items[i].price ==
            get(/databases/$(database)/documents/products/$(items[i].productId)).data.price
        );
    }

    function allItemsValid(items) {
      return items.size() <= 10 &&
        validItemAt(items, 0) && validItemAt(items, 1) && validItemAt(items, 2) &&
        validItemAt(items, 3) && validItemAt(items, 4) && validItemAt(items, 5) &&
        validItemAt(items, 6) && validItemAt(items, 7) && validItemAt(items, 8) &&
        validItemAt(items, 9);
    }

    // مجموع سعر*كمية كل عنصر — بديل عن reduce/loop غير المدعومين في القواعد
    function lineTotal(items, i) {
      return items.size() <= i ? 0 : items[i].price * items[i].quantity;
    }

    function computedSubtotal(items) {
      return lineTotal(items, 0) + lineTotal(items, 1) + lineTotal(items, 2) +
        lineTotal(items, 3) + lineTotal(items, 4) + lineTotal(items, 5) +
        lineTotal(items, 6) + lineTotal(items, 7) + lineTotal(items, 8) +
        lineTotal(items, 9);
    }

    // ─────────────────────────────────────────────────────────────────────
    //  ✅ إصلاح (Audit H-2 + M-4): التحقق من أن الخصم مرتبط فعلياً بكوبون
    //  صالح، وأن تحديث usageCount للكوبون يحدث ضمن *نفس* المعاملة التي
    //  تُنشئ هذا الطلب بالذات (عبر getAfter على مستند الكوبون)، بدل السماح
    //  بزيادة usageCount من أي كتابة منفصلة بلا طلب فعلي مرتبط بها.
    //  كما نتحقق أن المستخدم لم يستخدم هذا الكوبون من قبل (حد استخدام واحد
    //  لكل مستخدم) عبر مستند فرعي coupons/{code}/usedBy/{uid} يُنشأ ضمن
    //  نفس المعاملة، ولا يجوز أن يكون موجوداً مسبقاً.
    // ─────────────────────────────────────────────────────────────────────
    function noCouponUsed(data) {
      return !("couponCode" in data) || data.couponCode == null;
    }

    function couponDiscountValid(data) {
      let code = data.couponCode;
      let coupon = get(/databases/$(database)/documents/coupons/$(code)).data;
      let afterCoupon = getAfter(/databases/$(database)/documents/coupons/$(code)).data;
      let subtotal = data.subtotal;
      let expectedDiscount =
        coupon.discountType == 'percentage'
          ? subtotal * (coupon.discountValue / 100.0)
          : (coupon.discountValue < subtotal ? coupon.discountValue : subtotal);
      return
        coupon.isActive == true &&
        (!("expiresAt" in coupon) || coupon.expiresAt == null || coupon.expiresAt > request.time) &&
        subtotal >= coupon.minOrderAmount &&
        (coupon.usageLimit <= 0 || coupon.usageCount < coupon.usageLimit) &&
        // نفس المعاملة يجب أن تزيد usageCount بالضبط 1 على هذا الكوبون تحديداً
        afterCoupon.usageCount == coupon.usageCount + 1 &&
        // نفس المعاملة يجب أن تُنشئ سجل "استُخدم من طرف هذا المستخدم" ولم يكن موجوداً من قبل
        !exists(/databases/$(database)/documents/coupons/$(code)/usedBy/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/coupons/$(code)/usedBy/$(request.auth.uid)) != null &&
        // الخصم المُرسَل يطابق الخصم المحسوب فعلياً من الكوبون (هامش صغير جداً لأخطاء التقريب)
        (data.discount > expectedDiscount - 0.01 && data.discount < expectedDiscount + 0.01);
    }

    function discountValid(data) {
      return noCouponUsed(data)
        ? data.discount == 0
        : couponDiscountValid(data);
    }

    // ─────────────────────────────────────────────────────────────────────
    //  ✅ إصلاح (ثغرة مالية): shippingCost لم يكن يُتحقق منه هنا سابقاً إطلاقاً
    //  مقابل settings/store — فقط "رقم غير سالب" متّسق حسابياً مع total. أي
    //  عميل (APK مُعاد بناؤه، أو كتابة مباشرة لـFirestore بحساب مصادَق عليه)
    //  كان يستطيع إرسال shippingCost: 0 مع كل طلب بصرف النظر عن إعدادات
    //  الشحن الفعلية، بخسارة مالية فعلية متكرّرة. الآن نشتق قيمة الشحن
    //  المتوقَّعة من settings/store (نفس منطق shippingBase/freeShippingThreshold
    //  المستخدم بالسيرفر ضمن runOrderPricingTransaction) ونقارنها بالقيمة
    //  المُرسَلة، بنفس أسلوب التحقق من الكوبون أعلاه.
    // ─────────────────────────────────────────────────────────────────────
    function shippingCostValid(data) {
      let settings = get(/databases/$(database)/documents/settings/store).data;
      let base = ("shippingCost" in settings) ? settings.shippingCost : 30;
      let threshold = ("freeShippingThreshold" in settings) ? settings.freeShippingThreshold : 0;
      let expected = (threshold > 0 && data.subtotal >= threshold) ? 0 : base;
      return data.shippingCost == expected;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  users/{userId} — الملف الشخصي
    // ═══════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // ✅ إنشاء الحساب: فقط صاحب الـuid، ومنعاً لأي تصعيد صلاحيات ذاتي،
      // الحقل role يجب ألا يُرسَل إطلاقاً عند الإنشاء (المستخدم الجديد = "user" افتراضياً)
      allow create: if isOwner(userId) &&
        !("role" in request.resource.data) &&
        (!("fcmTokens" in request.resource.data) ||
          (request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 1));

      // ✅ التحديث: فقط صاحب الحساب، ولا يمكنه أبداً تعديل حقل role بنفسه
      // (الترقية لأدمن تتم فقط يدوياً من طرفكم عبر Admin SDK/Firebase Console)
      // ⚠️ ملاحظة مهمة (Audit المرحلة 4): جرّبتُ ابتداءً منع تعديل fcmTokens
      // بالكامل عبر Client SDK قياساً على role، لكن تراجعتُ عنها فوراً بعد
      // مراجعة تطبيق الأندرويد: ElevenFirebaseMessagingService.kt::onNewToken
      // يكتب التوكن الجديد مباشرة عبر Firestore **Client SDK** فعلياً (وليس
      // عبر السيرفر كما يفعل الموقع بـAdmin SDK الذي يتجاوز هذه القواعد أصلاً) —
      // منعها بالكامل كان سيكسر تسجيل توكنات الإشعارات على تطبيق الأندرويد
      // بالكامل. البديل الآمن هنا: السماح بالتوكنات لكنها لا تكبر بأكثر من
      // عنصر واحد لكل كتابة (يطابق سلوك arrayUnion(token) الحقيقي) وبحد
      // أقصى إجمالي 20 توكن لكل حساب (عدة أجهزة/متصفحات كافية لأي استخدام
      // شرعي)، بدل السماح بمصفوفة بلا أي حد كما كانت الحالة سابقاً (كان يمكن
      // تقنياً حشو الحقل بآلاف القيم الوهمية، مما يضخّم حجم الوثيقة ويزيد
      // خطر تجاوز حد Firestore لحجم المستند، وقد يُسقِط استدعاء
      // sendEachForMulticast بالكامل لتجاوزه حد 500 توكن بكل استدعاء).
      // ✅ نظام الإشعارات v2: notifUnreadCount عدّاد مشتق تحسبه فقط النواة
      // المشتركة (Cloud Functions / Admin SDK) ضمن نفس المعاملة الذرّية
      // التي تُنشئ الإشعار — لا يمكن للعميل تعديله مباشرة إطلاقاً (بخلاف
      // role يمكن أن "يُرسَل بلا تغيير"، هنا يُمنع إرساله كلياً من العميل
      // لتفادي أي التباس أو تسابق مع الزيادة الذرّية بالسيرفر).
      allow update: if isOwner(userId) &&
        (!("role" in request.resource.data) || unchanged("role")) &&
        !("notifUnreadCount" in request.resource.data) &&
        (!("fcmTokens" in request.resource.data) ||
          (request.resource.data.fcmTokens is list &&
           request.resource.data.fcmTokens.size() <= 20 &&
           request.resource.data.fcmTokens.size() <=
             resource.data.get('fcmTokens', []).size() + 1));

      allow delete: if false; // حذف الحساب يمر عبر deleteAccount() بالتطبيق (Firebase Auth) وليس مباشرة

      // ── users/{userId}/cart/{productId} ──────────────────────────────
      // بيانات عرض فقط (سعر/اسم/صورة وقت الإضافة) — لا تُستخدم كمصدر ثقة
      // عند الدفع؛ السيرفر وplaceOrder() يعيدان بناء السعر من المنتج نفسه.
      match /cart/{productId} {
        allow read, write: if isOwner(userId);
      }

      // ── users/{userId}/favorites/{productId} ─────────────────────────
      match /favorites/{productId} {
        allow read, write: if isOwner(userId);
      }

      // ── users/{userId}/addresses/{addressId} ─────────────────────────
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }

      // ── users/{userId}/notifications/{notifId} — نظام v2 ─────────────
      // القراءة لصاحب الحساب فقط (real-time listener بالموقع والتطبيق).
      // الإنشاء ممنوع كلياً من العميل — يمر حصراً عبر Admin SDK: إما Cloud
      // Function (functions/src/triggers/orderTriggers.ts عند إنشاء/تحديث
      // حالة طلب) أو mutation مصادَق عليها بالسيرفر. هذا يمنع بالضبط الثغرة
      // التي كانت موجودة سابقاً: عميل مُعدَّل (APK مفكوك/معاد تجميعه) قادر
      // على تلفيق إشعار مزيّف بحسابه هو نفسه (مثال: "تم تأكيد الدفع" لطلب
      // لم يُدفع فعلياً)، لأن الإنشاء كان مسموحاً بالكامل لصاحب الحساب.
      //
      // التعديل مسموح لصاحب الحساب، لكن محصور بحقلي isRead/readAt فقط (لا
      // يمكنه تغيير العنوان/النص/actionRoute لإشعار موجود بالفعل)، والحذف
      // مسموح بالكامل — كلاهما يعملان تلقائياً بدون اتصال (Firestore SDK
      // يُصان الكتابة بطابور offline محلي ويُزامنها عند عودة الاتصال).
      // عدّاد notifUnreadCount لا يتأثر بهذه الكتابة مباشرة أبداً — تسويته
      // تتم حصراً عبر trigger مستقل (notificationCounterTrigger.ts) يلاحظ
      // كل كتابة هنا بصرف النظر عن مصدرها ويُحدّث العدّاد ذرّياً بنفسه.
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId) && onlyChangedKeys(['isRead', 'readAt']);
        allow delete: if isOwner(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  products/{productId} — قراءة عامة، والكتابة عبر لوحة التحكم فقط
    // ═══════════════════════════════════════════════════════════════════
    match /products/{productId} {
      allow read: if true; // كتالوج عام، لا بيانات حساسة

      // ✅ الاستثناء الوحيد: إنقاص المخزون أثناء إتمام الطلب من تطبيق الأندرويد
      // (placeOrder يكتب مباشرة لـFirestore بدون سيرفر وسيط). يُسمح فقط بتعديل
      // "stock" (ولا يمكن أن يزيد!) و"updatedAt" — أي شيء آخر (السعر، الاسم، isActive...) ممنوع تماماً.
      // ✅ تخفيف جزئي (Audit L-1): لا يوجد ربط مباشر بين هذه الكتابة وبين
      // إنشاء طلب حقيقي فعلياً (معرّف الطلب عشوائي، ولا يمكن التحقق منه هنا
      // عبر getAfter كما صار مع الكوبونات). هذا يعني نظرياً أن أي مستخدم
      // مسجّل دخول يملك توكن صالح (حتى خارج التطبيق تماماً، عبر سكربت مباشر)
      // يقدر ينقص مخزون أي منتج بدون شراء فعلي — تخريب/DoS على المخزون، وليس
      // تسريب بيانات. لا يوجد حل كامل عبر Firestore Rules وحدها لهذا النمط
      // (يتطلب Firebase App Check لضمان أن الطلب صادر فعلاً من تطبيق حقيقي
      // — راجع ملاحظة الخطة). كتخفيف جزئي فقط بانتظار ذلك: نحدّ من مقدار
      // النقص المسموح بكل كتابة واحدة.
      // ✅ تشديد إضافي (Audit المرحلة 3، بند 3.7): خُفِّض الحد من 100 إلى 10
      // وحدات لكل كتابة — يطابق حد items.size() <= 10 المفروض أصلاً على كل
      // طلب واحد بقاعدة orders/create أعلاه (أي طلب شرعي واحد لا ينقص أكثر
      // من هذا القدر من منتج واحد أساساً)، فيبطئ أي إساءة استخدام آلية أكثر
      // دون التأثير على أي استخدام حقيقي.
      allow update: if isSignedIn() &&
        onlyChangedKeys(['stock', 'updatedAt']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= resource.data.stock &&
        resource.data.stock - request.resource.data.stock <= 10;

      allow create, delete: if false; // فقط عبر لوحة التحكم (Admin SDK)
    }

    // ═══════════════════════════════════════════════════════════════════
    //  categories / brands / banners — قراءة عامة، كتابة إدارية فقط
    // ═══════════════════════════════════════════════════════════════════
    match /categories/{id} {
      allow read: if true;
      allow write: if false; // عبر لوحة التحكم فقط (Admin SDK)
    }
    match /brands/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  settings/store — إعدادات المتجر (شحن، بيانات بنكية...)
    // ═══════════════════════════════════════════════════════════════════
    match /settings/{docId} {
      allow read: if true; // مطلوبة للجميع (حساب الشحن حتى بدون تسجيل دخول)
      allow write: if false; // عبر لوحة التحكم فقط
    }

    // ═══════════════════════════════════════════════════════════════════
    //  counters/orders — عدّاد أرقام الطلبات التسلسلي
    // ═══════════════════════════════════════════════════════════════════
    match /counters/{counterId} {
      allow read: if isSignedIn();
      // ✅ يُسمح فقط بزيادة الحقل current بمقدار 1 بالضبط — يمنع أي تلاعب
      // برقم الطلب (تخطي أرقام، إعادة استخدام رقم، إلخ)
      allow update: if isSignedIn() &&
        onlyChangedKeys(['current']) &&
        request.resource.data.current == resource.data.current + 1;
      // ✅ إصلاح (Audit L-2): "create" كانت مسموحة لأي مستخدم مسجّل دخول
      // بدون أي تحقق من القيمة الابتدائية — لو تصادف أن هذا أول طلب يصير
      // بالمتجر إطلاقاً (نافذة زمنية ضيقة، لكنها موجودة)، كان يمكن لأي
      // مستخدم يكتب current بأي رقم عشوائي (سالب، أو ضخم جداً)، فيُفسد بداية
      // تسلسل أرقام الطلبات نهائياً. الآن يُفرض أن أول قيمة ابتدائية دائماً
      // نفس نقطة البداية الرسمية المستخدمة بكود التطبيق (11001000) أو أول
      // زيادة طبيعية عليها (11001001) — نفس القيمتين الوحيدتين اللتين قد
      // يكتبهما الكود الشرعي فعلياً عند أول طلب.
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['current']) &&
        request.resource.data.current is number &&
        (request.resource.data.current == 11001000 || request.resource.data.current == 11001001);
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  coupons/{code} — كوبونات الخصم (تُدار من لوحة التحكم)
    // ═══════════════════════════════════════════════════════════════════
    match /coupons/{code} {
      // القراءة لأي مستخدم مسجّل دخول فقط (يلزم تسجيل الدخول أصلاً للوصول للسلة/الدفع)
      allow read: if isSignedIn();

      // ✅ إصلاح (Audit H-2): سابقاً كان يمكن زيادة usageCount بكتابة منفصلة
      // بلا أي طلب فعلي مرتبط بها (استنزاف الكوبون / DoS على العروض). الآن
      // نفرض أن هذه الزيادة يجب أن تحدث **ضمن نفس المعاملة** التي تُنشئ طلباً
      // فعلياً لهذا المستخدم بهذا الكوبون تحديداً — يتحقق منه فعلياً عبر
      // discountValid()/couponDiscountValid() في قاعدة orders/create أعلاه
      // (كلا الشرطين يجب أن يتحققا معاً بما أنهما كتابتان بنفس المعاملة).
      allow update: if isSignedIn() &&
        onlyChangedKeys(['usageCount', 'updatedAt']) &&
        resource.data.isActive == true &&
        request.resource.data.usageCount == resource.data.usageCount + 1 &&
        !exists(/databases/$(database)/documents/coupons/$(code)/usedBy/$(request.auth.uid));

      allow create, delete: if false; // فقط عبر لوحة التحكم (Admin SDK)

      // ── coupons/{code}/usedBy/{uid} ──────────────────────────────────
      // ✅ إصلاح (Audit M-4): سجل "استخدم هذا المستخدم هذا الكوبون من قبل" —
      // يمنع إعادة استخدام نفس الكوبون أكثر من مرة لكل مستخدم، بمعزل عن
      // usageLimit العام. يُنشأ مرة واحدة فقط لكل (مستخدم، كوبون)، ولا يُعدَّل
      // ولا يُحذف أبداً من العميل.
      match /usedBy/{userId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && !exists(
          /databases/$(database)/documents/coupons/$(code)/usedBy/$(userId)
        );
        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    //  orders/{orderId} — الطلبات
    // ═══════════════════════════════════════════════════════════════════
    match /orders/{orderId} {
      // القراءة: صاحب الطلب أو الأدمن فقط
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // ✅ الإنشاء: يخص طلبات تطبيق الأندرويد (placeOrder يكتب مباشرة لـFirestore).
      // تحقق أساسي إجباري:
      //   • الطلب يخص صاحبه (userId == uid المُصادَق عليه)، ولا يمكن انتحال هوية غيره
      //   • الحالة الابتدائية "pending" فقط (لا يمكن إنشاء طلب "مُسلَّم" مثلاً)
      //   • الحسابات المالية متّسقة داخلياً: total = subtotal - discount + shippingCost
      //   • القيم المالية غير سالبة
      //   • (Audit C-1) سعر كل عنصر ومجموعه الفرعي يُتحقق منهما فعلياً مقابل مستند
      //     المنتج الحي عبر allItemsValid()/computedSubtotal() — لم يعد هذا يعتمد فقط
      //     على كود التطبيق (placeOrder داخل transaction)؛ القاعدة نفسها الآن خط دفاع
      //     حقيقي ومستقل حتى ضد كتابة مباشرة لقاعدة البيانات خارج التطبيق تماماً.
      //   • (Audit H-2/M-4) الخصم مرتبط وجوباً بكوبون صالح تُحدَّث حالته usageCount
      //     ويُسجَّل استخدامه لهذا المستخدم ضمن نفس المعاملة، عبر discountValid().
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status.lower() == 'pending' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number && request.resource.data.subtotal >= 0 &&
        request.resource.data.discount is number && request.resource.data.discount >= 0 &&
        request.resource.data.shippingCost is number && request.resource.data.shippingCost >= 0 &&
        request.resource.data.total is number && request.resource.data.total >= 0 &&
        request.resource.data.total ==
          request.resource.data.subtotal - request.resource.data.discount + request.resource.data.shippingCost &&
        // ✅ إصلاح (ثغرة مالية): shippingCost يجب أن يطابق القيمة المشتقة فعلياً
        // من settings/store (سعر الشحن الأساسي أو صفر إن تجاوز subtotal حد
        // الشحن المجاني) — وليس أي رقم غير سالب يختاره العميل، راجع shippingCostValid().
        shippingCostValid(request.resource.data) &&
        // ✅ إصلاح (Audit C-1): كل سعر عنصر يجب أن يطابق سعر المنتج الحقيقي وقت الطلب،
        // والمجموع الفرعي يجب أن يطابق مجموع (سعر × كمية) الحقيقي لكل العناصر —
        // هذا يمنع إنشاء طلب بسعر مُلفَّق عبر كتابة مباشرة لقاعدة البيانات خارج التطبيق.
        allItemsValid(request.resource.data.items) &&
        request.resource.data.subtotal == computedSubtotal(request.resource.data.items) &&
        // ✅ إصلاح (Audit H-2/M-4): الخصم يجب أن يكون صفراً بلا كوبون، أو مرتبطاً
        // فعلياً بكوبون صالح تُحدَّث حالته ضمن نفس معاملة إنشاء هذا الطلب بالذات.
        discountValid(request.resource.data);

      // ✅ لا تحديث ولا حذف من العميل مباشرة إطلاقاً — أي تغيير لحالة الطلب
      // (تم الدفع/تم الشحن/إلغاء...) يجب أن يمر فقط عبر لوحة تحكم الموقع (Admin SDK)
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  notifications/{id} — مجموعة علوية قديمة، غير مستخدَمة إطلاقاً
    //  بنظام الإشعارات v2 (مصدر الحقيقة الوحيد الآن هو
    //  users/{uid}/notifications حصراً). أُبقيت هنا مرفوضة بالكامل فقط
    //  حتى تُحذف فعلياً أي مستندات متبقية فيها يدوياً، ثم يمكن حذف هذا
    //  الـmatch block نهائياً من الملف.
    // ═══════════════════════════════════════════════════════════════════
    match /notifications/{id} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  أي مسار آخر غير مذكور أعلاه: يُمنع تماماً افتراضياً (Deny by default)
    // ═══════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
