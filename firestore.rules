rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  ELEVEN STORE — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════
//  ملاحظة مهمة جداً قبل القراءة:
//  • السيرفر (store/server عبر tRPC) يستخدم Firebase Admin SDK — وهذا يتجاوز
//    هذه القواعد بالكامل دائماً. القواعد هنا لا "تحمي" الويب في أغلب مساراته
//    لأنه لا يتحدث مع Firestore مباشرة إلا في حالة واحدة (Register.tsx).
//  • تطبيق الأندرويد يتحدث مع Firestore مباشرة عبر Client SDK في كل شيء —
//    فهذه القواعد هي خط الدفاع الحقيقي الوحيد لكل عمليات الأندرويد.
//  • بدون نشر هذا الملف فعلياً (firebase deploy --only firestore:rules)
//    فإن أي شخص يملك مفاتيح Firebase العامة (موجودة أصلاً بكود التطبيق/الموقع،
//    وهذا طبيعي وليس تسريباً) يقدر يقرأ/يكتب أي شيء في القاعدة مباشرة.
//  • ✅ تحديث: الطلبات والمخزون وعدّاد الطلبات واستخدام الكوبونات ورسائل التواصل لم تعد
//    تُكتب من العميل إطلاقاً — تمر عبر Cloud Functions `placeOrder` و`submitContactMessage`
//    (Admin SDK) فقط، والقواعد ترفض أي كتابة مباشرة عليها. لا تنشر هذه القواعد قبل نشر الدوال
//    وإصدار نسخة الأندرويد الجديدة (النسخ القديمة تكتب مباشرة وستفشل) — راجع FIXES-AR.md.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    //  دوال مساعدة عامة
    // ─────────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ⚠️ يقرأ مستند المستخدم نفسه للتحقق من الدور — استخدام get() هنا مقصود
    // ومحدود (مرة واحدة فقط لكل تحقق)، ولا يوجد تطبيق أندرويد إداري حالياً
    // (لوحة التحكم كلها بالموقع عبر Admin SDK)، لكن هذا يبقى خط دفاع إضافي.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // فرق الحقول المتغيّرة بين النسخة القديمة والجديدة — لتقييد أي تحديث
    // على حقول محدّدة فقط (مثال: لا يمكن تغيير أي شيء عدا "stock")
    function onlyChangedKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ✅ إصلاح (Audit): users/{uid}/addresses كانت allow write بلا أي تحقق
    // إطلاقاً — على عكس كل مجموعة أخرى بهذا الملف. isValidLatLng المكافئة
    // بـshared/deliveryZones.ts معرَّفة لكنها لم تكن مستخدَمة هنا أصلاً. الآن:
    // حقول العنوان النصية مطلوبة بحدود طول معقولة (لا تخزين نصوص ضخمة تعسّفاً)،
    // isDefault منطقي إجباري. latitude/longitude تسامحية مع سجلات قديمة قد
    // لا تحوي الحقلين أصلاً (أُضيفا لاحقاً بموديل الأندرويد) — إن وُجدا يجب
    // أن يكونا 0/0 معاً (لم يُحدَّد موقع) أو زوجاً ضمن المدى الجغرافي الصحيح،
    // تماماً كـisValidLatLng.
    // تسامح: سجلات قديمة قد تحوي "name" بدل "fullName" (نفس منطق
    // Address.displayName بموديل الأندرويد: fullName.ifBlank { name }) —
    // يكفي وجود أحدهما كنص.
    function isValidAddress(data) {
      return
        (
          ("fullName" in data && data.fullName is string && data.fullName.size() <= 100) ||
          ("name" in data && data.name is string && data.name.size() <= 100)
        ) &&
        data.phone is string && data.phone.size() <= 30 &&
        data.city is string && data.city.size() <= 60 &&
        data.address is string && data.address.size() <= 300 &&
        data.isDefault is bool &&
        (
          !("latitude" in data) && !("longitude" in data) ||
          (
            data.latitude is number && data.longitude is number &&
            (
              (data.latitude == 0 && data.longitude == 0) ||
              (data.latitude >= -90 && data.latitude <= 90 &&
               data.longitude >= -180 && data.longitude <= 180)
            )
          )
        );
    }

    // ملاحظة: كانت هنا دوال تحقق مسار إنشاء الطلب المباشر (السعر، الشحن، الكوبون، مضلّع
    // التوصيل). أُزيلت لأن إنشاء الطلب صار حصراً عبر Cloud Function `placeOrder`
    // (functions/src/callables/placeOrder.ts، Admin SDK) — القواعد ترفض أي كتابة مباشرة عليه.

    // ═══════════════════════════════════════════════════════════════════
    //  users/{userId} — الملف الشخصي
    // ═══════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // ✅ إنشاء الحساب: فقط صاحب الـuid، ومنعاً لأي تصعيد صلاحيات ذاتي،
      // الحقل role يجب ألا يُرسَل إطلاقاً عند الإنشاء (المستخدم الجديد = "user" افتراضياً)
      allow create: if isOwner(userId) &&
        !("role" in request.resource.data) &&
        (!("fcmTokens" in request.resource.data) ||
          (request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 1));

      // ✅ التحديث: فقط صاحب الحساب، ولا يمكنه أبداً تعديل حقل role بنفسه
      // (الترقية لأدمن تتم فقط يدوياً من طرفكم عبر Admin SDK/Firebase Console)
      // ⚠️ ملاحظة مهمة (Audit المرحلة 4): جرّبتُ ابتداءً منع تعديل fcmTokens
      // بالكامل عبر Client SDK قياساً على role، لكن تراجعتُ عنها فوراً بعد
      // مراجعة تطبيق الأندرويد: ElevenFirebaseMessagingService.kt::onNewToken
      // يكتب التوكن الجديد مباشرة عبر Firestore **Client SDK** فعلياً (وليس
      // عبر السيرفر كما يفعل الموقع بـAdmin SDK الذي يتجاوز هذه القواعد أصلاً) —
      // منعها بالكامل كان سيكسر تسجيل توكنات الإشعارات على تطبيق الأندرويد
      // بالكامل. البديل الآمن هنا: السماح بالتوكنات لكنها لا تكبر بأكثر من
      // عنصر واحد لكل كتابة (يطابق سلوك arrayUnion(token) الحقيقي) وبحد
      // أقصى إجمالي 20 توكن لكل حساب (عدة أجهزة/متصفحات كافية لأي استخدام
      // شرعي)، بدل السماح بمصفوفة بلا أي حد كما كانت الحالة سابقاً (كان يمكن
      // تقنياً حشو الحقل بآلاف القيم الوهمية، مما يضخّم حجم الوثيقة ويزيد
      // خطر تجاوز حد Firestore لحجم المستند، وقد يُسقِط استدعاء
      // sendEachForMulticast بالكامل لتجاوزه حد 500 توكن بكل استدعاء).
      // ✅ نظام الإشعارات v2: notifUnreadCount عدّاد مشتق تحسبه فقط النواة
      // المشتركة (Cloud Functions / Admin SDK) ضمن نفس المعاملة الذرّية
      // التي تُنشئ الإشعار — لا يمكن للعميل تعديله مباشرة إطلاقاً (بخلاف
      // role يمكن أن "يُرسَل بلا تغيير"، هنا يُمنع إرساله كلياً من العميل
      // لتفادي أي التباس أو تسابق مع الزيادة الذرّية بالسيرفر).
      allow update: if isOwner(userId) &&
        (!("role" in request.resource.data) || unchanged("role")) &&
        // ✅ إصلاح (لوحة التحكم — أدمنز متعددون): بنفس منطق role تمامًا —
        // adminPermissions محسوبة من role أصلاً فلا خطر تصعيد صلاحيات مباشر
        // منها بمفردها، لكن disabled كان بلا حماية: أدمن أو مستخدم محظور
        // كان يقدر يعيد disabled لـfalse بنفسه عبر Client SDK مباشرة (الحظر
        // الحقيقي عبر Firebase Auth disabled يبقى فعّالاً دائماً ولا يتأثر،
        // لكن سياق تسجيل الدخول بالسيرفر كان سيثق بالنسخة المزوَّرة هنا حتى
        // تنتهي صلاحية الجلسة القديمة).
        (!("adminPermissions" in request.resource.data) || unchanged("adminPermissions")) &&
        (!("disabled" in request.resource.data) || unchanged("disabled")) &&
        // ✅ إصلاح: كان الشرط السابق !("notifUnreadCount" in request.resource.data)
        // — لكن request.resource.data في التحديث هو المستند كاملاً بعد الدمج (يشمل
        // الحقول القديمة)، وnotifUnreadCount يكتبه Cloud Function على كل مستخدم
        // لديه إشعارات. النتيجة: أي كتابة من العميل على users/{uid} (تسجيل الدخول
        // بجوجل، تسجيل توكن FCM، تسجيل الخروج، تعديل الملف الشخصي) كانت تُرفض
        // PERMISSION_DENIED لكل من لديه عدّاد. الصحيح: منع *تغيير* الحقل فقط.
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["notifUnreadCount"]) &&
        (!("fcmTokens" in request.resource.data) ||
          (request.resource.data.fcmTokens is list &&
           request.resource.data.fcmTokens.size() <= 20 &&
           request.resource.data.fcmTokens.size() <=
             resource.data.get('fcmTokens', []).size() + 1));

      allow delete: if false; // حذف الحساب يمر عبر deleteAccount() بالتطبيق (Firebase Auth) وليس مباشرة

      // ── users/{userId}/cart/{productId} ──────────────────────────────
      // بيانات عرض فقط (سعر/اسم/صورة وقت الإضافة) — لا تُستخدم كمصدر ثقة
      // عند الدفع؛ السيرفر وplaceOrder() يعيدان بناء السعر من المنتج نفسه.
      match /cart/{productId} {
        allow read, write: if isOwner(userId);
      }

      // ── users/{userId}/favorites/{productId} ─────────────────────────
      match /favorites/{productId} {
        allow read, write: if isOwner(userId);
      }

      // ── users/{userId}/addresses/{addressId} ─────────────────────────
      match /addresses/{addressId} {
        allow read, delete: if isOwner(userId);
        // ✅ إصلاح: راجع isValidAddress() أعلاه — كان بلا أي تحقق إطلاقاً.
        // create يفرض التحقق الكامل؛ update يسمح أيضاً بتحديثات جزئية (مثل
        // batch إلغاء isDefault عن باقي العناوين) لأن request.resource.data
        // يمثّل المستند الناتج كاملاً بعد الدمج، فيُفحَص بنفس الدالة.
        allow create, update: if isOwner(userId) && isValidAddress(request.resource.data);
      }

      // ── users/{userId}/notifications/{notifId} — نظام v2 ─────────────
      // القراءة لصاحب الحساب فقط (real-time listener بالموقع والتطبيق).
      // الإنشاء ممنوع كلياً من العميل — يمر حصراً عبر Admin SDK: إما Cloud
      // Function (functions/src/triggers/orderTriggers.ts عند إنشاء/تحديث
      // حالة طلب) أو mutation مصادَق عليها بالسيرفر. هذا يمنع بالضبط الثغرة
      // التي كانت موجودة سابقاً: عميل مُعدَّل (APK مفكوك/معاد تجميعه) قادر
      // على تلفيق إشعار مزيّف بحسابه هو نفسه (مثال: "تم تأكيد الدفع" لطلب
      // لم يُدفع فعلياً)، لأن الإنشاء كان مسموحاً بالكامل لصاحب الحساب.
      //
      // التعديل مسموح لصاحب الحساب، لكن محصور بحقلي isRead/readAt فقط (لا
      // يمكنه تغيير العنوان/النص/actionRoute لإشعار موجود بالفعل)، والحذف
      // مسموح بالكامل — كلاهما يعملان تلقائياً بدون اتصال (Firestore SDK
      // يُصان الكتابة بطابور offline محلي ويُزامنها عند عودة الاتصال).
      // عدّاد notifUnreadCount لا يتأثر بهذه الكتابة مباشرة أبداً — تسويته
      // تتم حصراً عبر trigger مستقل (notificationCounterTrigger.ts) يلاحظ
      // كل كتابة هنا بصرف النظر عن مصدرها ويُحدّث العدّاد ذرّياً بنفسه.
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId) && onlyChangedKeys(['isRead', 'readAt']);
        allow delete: if isOwner(userId);
      }

      // ── users/{userId}/adminAlerts/{alertId} — جرس تنبيهات لوحة التحكم (v2) ──
      // فان-آوت لكل أدمن مستهدَف: عند إنشاء تنبيه بمستند adminAlerts العلوي
      // (functions/src/lib/adminAlerts.ts)، يُكتب أيضاً نسخة هنا لكل أدمن
      // كانت صلاحيته وقتها تشمل requiredPermission الخاص بالتنبيه. هذا يحوّل
      // فلترة الصلاحيات من "وقت القراءة" (كما كانت بـadmin-alerts-router.ts)
      // إلى "وقت الكتابة" فقط — التضحية الوحيدة: أدمن يُمنح صلاحية جديدة لاحقاً
      // لا يرى تلقائياً تنبيهات قديمة تخص تلك الصلاحية إلا عبر backfill صريح
      // (راجع server/admin-alerts-backfill.ts) يُستدعى فوراً عند منح الصلاحية.
      // بالمقابل نكسب: قاعدة أمان بسيطة isOwner() فقط (بلا get() على صلاحيات
      // متغيّرة داخل استعلام قائمة)، تدعم onSnapshot حي بثقة تامة — تماماً
      // كمصدر الحقيقة نفسه المستخدم لإشعارات العميل النهائي أعلاه.
      match /adminAlerts/{alertId} {
        allow read: if isOwner(userId);
        allow create: if false; // فقط عبر Admin SDK (Cloud Functions أو مسار منح الصلاحيات بالسيرفر)
        allow update: if isOwner(userId) && onlyChangedKeys(['isRead', 'readAt']);
        allow delete: if false; // التنظيف عبر functions/src/scheduled/adminAlertsCleanup.ts فقط
      }
    }

    // ✅ المخزون يُعدَّل حصراً من السيرفر (Admin SDK) داخل transaction الطلب — كان أي حساب موثَّق
    // يستطيع إنقاص المخزون بلا طلب حقيقي (استنزاف مخزون). القراءة عامة (كتالوج).
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  categories / brands / banners — قراءة عامة، كتابة إدارية فقط
    // ═══════════════════════════════════════════════════════════════════
    match /categories/{id} {
      allow read: if true;
      allow write: if false; // عبر لوحة التحكم فقط (Admin SDK)
    }
    match /brands/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  settings/store — إعدادات المتجر (شحن، بيانات بنكية...)
    // ═══════════════════════════════════════════════════════════════════
    match /settings/{docId} {
      allow read: if true; // مطلوبة للجميع (حساب الشحن حتى بدون تسجيل دخول)
      allow write: if false; // عبر لوحة التحكم فقط
    }

    // ✅ عدّاد رقم الطلب داخلي بالكامل (Admin SDK فقط) — لا قراءة ولا كتابة من العميل.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // معاينة الكوبون بالتطبيق تقرأ المستند بمعرّفه (get فقط، بلا list = لا تعداد للأكواد).
    // ✅ الاستخدام (usageCount + usedBy) يُسجَّل حصراً داخل transaction الطلب بالسيرفر — كان
    // بالإمكان حرق كوبون بحسابات موثَّقة متعددة بلا أي طلب.
    match /coupons/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;

      match /usedBy/{userId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ✅ الإرسال عبر Cloud Function `submitContactMessage` (حد لكل IP وكل مرسِل قبل الكتابة).
    // كانت القاعدة السابقة تسمح بالإنشاء لأي شخص بلا تسجيل دخول ولا حد معدل (سبام + إغراق
    // تنبيهات الأدمن). القراءة/الإدارة عبر لوحة التحكم (Admin SDK) فقط.
    match /contactMessages/{id} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // ✅ الإنشاء حصراً عبر Cloud Function `placeOrder` (Admin SDK) داخل transaction واحدة تشمل
      // المخزون والكوبون والعدّاد. لم تعد هناك أي كتابة مباشرة من العميل على الطلبات.
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  notifications/{id} — مجموعة علوية قديمة، غير مستخدَمة إطلاقاً
    //  بنظام الإشعارات v2 (مصدر الحقيقة الوحيد الآن هو
    //  users/{uid}/notifications حصراً). أُبقيت هنا مرفوضة بالكامل فقط
    //  حتى تُحذف فعلياً أي مستندات متبقية فيها يدوياً، ثم يمكن حذف هذا
    //  الـmatch block نهائياً من الملف.
    // ═══════════════════════════════════════════════════════════════════
    match /notifications/{id} {
      allow read, write: if false;
    }

    // ✅ إضافة: سجل أخطاء النظام المركزي (لوحة التحكم + الأندرويد + السيرفر).
    // ممنوع كلياً من العميل المباشر (قراءة وكتابة) عمداً — كل الوصول عبر
    // tRPC (Admin SDK) فقط عبر server/error-log-router.ts. هذا قرار مقصود
    // بعد حادثة تعطّل ميزة أخرى بسبب اعتمادها على App Check توكن صحيح؛ هذه
    // الميزة لا تعتمد على ذلك إطلاقاً. (مغطّى بالفعل بقاعدة deny-by-default
    // أدناه، لكن نُصرّح بها هنا كباقي المجموعات لتوضيح النية).
    match /systemErrorLogs/{id} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    //  أي مسار آخر غير مذكور أعلاه: يُمنع تماماً افتراضياً (Deny by default)
    // ═══════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
